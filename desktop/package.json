{
  "name": "app-review-insight-desktop",
  "version": "0.1.0",
  "description": "Desktop wrapper for App Review Insight (Electron + PyInstaller)",
  "main": "main.js",
  "author": "App Review Insight",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/idontkown815/app-eval-insight.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:frontend": "cd ../frontend && npm install && npm run build",
    "build:backend": "pyinstaller --noconfirm --distpath ../backend/dist --workpath ../backend/build backend.spec",
    "build:electron": "electron-builder",
    "build:all": "npm run build:frontend && npm run build:backend && npm run build:electron"
  },
  "build": {
    "appId": "com.appreviewinsight.desktop",
    "productName": "App Review Insight",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "idontkown815",
      "repo": "app-eval-insight"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/.env.example",
        "to": "config.env.example"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png",
      "signingHashAlgorithms": []
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "App Review Insight"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
